{
  "name": "saba-support",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../website-ecom/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/health", "/ready"]
  },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "StoreDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StoreDO"] }],
  "vars": {
    "NACE_BASE_URL": "https://console.nace.ai",
    "NACE_MODEL": "drex-v1.5",
    "LLM_BASE_URL": "https://generativelanguage.googleapis.com/v1beta/openai",
    "LLM_MODEL_FAST": "gemma-4-26b-a4b-it"
  },
  "observability": { "enabled": true }
}
